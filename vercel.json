{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "^/zohoverify/(.*)",
      "dest": "/zohoverify/$1"
    },
    {
      "src": "^/verifyforzoho\\.html$",
      "dest": "/verifyforzoho.html"
    },
    {
      "src": "^/verifyzoho\\.html$",
      "dest": "/verifyzoho.html"
    },
    {
      "src": "^/verifyforzoho$",
      "dest": "/verifyforzoho.html"
    },
    {
      "src": "^/verifyzoho$",
      "dest": "/verifyzoho.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
